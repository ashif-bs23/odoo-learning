<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_partner_borrowed_books" model="ir.actions.act_window">
        <field name="name">Borrowed Books</field>
        <field name="res_model">learner.library.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('borrower_id', '=', active_id), ('state', '=', 'borrowed')]</field>
    </record>

    <record id="view_partner_form_learner_library" model="ir.ui.view">
        <field name="name">res.partner.form.learner.library</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(action_partner_borrowed_books)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-book">
                    <field
                        name="borrowed_book_count"
                        widget="statinfo"
                        string="Borrowed"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

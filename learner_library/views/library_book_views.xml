<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="learner_library_book_view_list" model="ir.ui.view">
        <field name="name">learner.library.book.list</field>
        <field name="model">learner.library.book</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'borrowed' and days_overdue &gt; 0"
                decoration-warning="state == 'borrowed' and days_overdue &lt;= 0"
                decoration-success="state == 'available'"
                decoration-muted="state == 'draft'">
                <field name="reference"/>
                <field name="name"/>
                <field name="author_id"/>
                <field name="category"/>
                <field name="borrower_id"/>
                <field name="due_date"/>
                <field name="days_overdue" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="learner_library_book_view_form" model="ir.ui.view">
        <field name="name">learner.library.book.form</field>
        <field name="model">learner.library.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_set_available"
                        type="object"
                        string="Set Available"
                        invisible="state != 'draft'"
                        class="btn-primary"/>
                    <button
                        name="action_borrow"
                        type="object"
                        string="Borrow"
                        invisible="state != 'available'"
                        class="btn-primary"/>
                    <button
                        name="action_return"
                        type="object"
                        string="Return"
                        invisible="state != 'borrowed'"/>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,available,borrowed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Book">
                            <field name="name"/>
                            <field name="reference" readonly="1"/>
                            <field name="isbn"/>
                            <field name="author_id"/>
                            <field name="category"/>
                            <field name="page_count"/>
                            <field name="publication_date"/>
                        </group>
                        <group string="Loan">
                            <field name="borrower_id" readonly="state == 'borrowed'"/>
                            <field name="borrow_date"/>
                            <field name="due_date"/>
                            <field name="borrower_phone" readonly="1"/>
                            <field name="days_overdue" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="learner_library_book_view_search" model="ir.ui.view">
        <field name="name">learner.library.book.search</field>
        <field name="model">learner.library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="isbn"/>
                <filter
                    string="Available"
                    name="filter_available"
                    domain="[('state', '=', 'available')]"/>
                <filter
                    string="Overdue"
                    name="filter_overdue"
                    domain="[('state', '=', 'borrowed'), ('due_date', '&lt;', context_today())]"/>
                <group>
                    <filter
                        string="Author"
                        name="group_author"
                        context="{'group_by': 'author_id'}"/>
                    <filter
                        string="Category"
                        name="group_category"
                        context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_learner_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">learner.library.book</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-create-button">
                <button type="button" class="btn btn-primary" t-on-click="openCustomers">
                    <t t-esc="customersLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="openLeads">
                    <t t-esc="leadsLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="openSettings" t-att-title="settingsLabel">
                    <i class="fa fa-cog"/>
                </button>
            </t>
            <div class="d-flex flex-wrap align-items-start p-3">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                        <t t-component="item.Component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

    <t t-name="awesome_dashboard.ConfigurationDialog">
        <Dialog title="title" size="'md'">
            <t t-foreach="items" t-as="item" t-key="item.id">
                <CheckBox value="item.enabled" onChange="(enabled) => this.onChange(enabled, item)">
                    <t t-esc="item.description"/>
                </CheckBox>
            </t>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="apply">
                    <t t-esc="applyLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
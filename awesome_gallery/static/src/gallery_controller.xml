<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_gallery.GalleryController">
        <Layout display="props.display">
            <t t-foreach="model.records" t-as="record" t-key="record.id">
                <div>
                    id: <t t-esc="record.id"/>
                    —
                    size: <t t-esc="record[props.archInfo.imageField]"/>
                </div>
            </t>
        </Layout>
    </t>
</templates>
